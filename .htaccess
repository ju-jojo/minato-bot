# CGI実行を許可
<Files "webhook.cgi">
  SetHandler cgi-script
  Options +ExecCGI
</Files>

# .env や状態ファイルへのアクセスを禁止
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "\.(env|log|py)$">
  Require all denied
</FilesMatch>

# state/ logs/ ディレクトリのリスト表示禁止
Options -Indexes

# images/ ディレクトリの中身は公開（Threadsからアクセス）
<Directory "images">
  Options -Indexes
  Require all granted
</Directory>
